[Unit]
# Run only inside GNOME so other sessions (Hyprland, KDE...) on the same user are not touched
PartOf=gnome-session.target
After=gnome-session.target
Description=Sync GTK/Shell theme with GNOME color-scheme

[Service]
Type=simple
ExecStart=%h/.local/bin/color-scheme-sync.sh
Restart=always
RestartSec=3

[Install]
WantedBy=gnome-session.target
