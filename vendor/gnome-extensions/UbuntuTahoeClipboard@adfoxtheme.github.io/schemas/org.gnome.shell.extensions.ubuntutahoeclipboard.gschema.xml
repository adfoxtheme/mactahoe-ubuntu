<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.ubuntutahoeclipboard" path="/org/gnome/shell/extensions/ubuntutahoeclipboard/">
    <key name="toggle-menu" type="as">
      <default><![CDATA[['<Super><Alt>space']]]></default>
      <summary>Shortcut to open the clipboard menu</summary>
      <description>Key combination to toggle clipboard history</description>
    </key>
    <key name="history-size" type="i">
      <default>20</default>
      <summary>Maximum number of stored items</summary>
      <description>Keep up to 20 recent items</description>
    </key>
  </schema>
</schemalist>
