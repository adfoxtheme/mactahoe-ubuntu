<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.ubuntutahoespotlight" path="/org/gnome/shell/extensions/ubuntutahoespotlight/">
    <key name="toggle-spotlight" type="as">
      <default><![CDATA[['<Super><Alt>f']]]></default>
      <summary>Shortcut to open Spotlight</summary>
      <description>Key combination to toggle macOS Tahoe-style Spotlight search</description>
    </key>
    <key name="max-results" type="i">
      <default>8</default>
      <summary>Maximum number of results</summary>
      <description>Number of search results shown at once</description>
    </key>
  </schema>
</schemalist>
